  <Fanex.MailDelivery.Client environment="local" applicationSendMailId="1" siteId="3" rabbitMQConnectionString="host=ha.nexdev.net:5672;virtualHost=/MailStationHost;username=rabbitclient;timeout=120">
  </Fanex.MailDelivery.Client>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
