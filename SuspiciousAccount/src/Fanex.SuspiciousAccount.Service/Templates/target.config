<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="Mail.Enabled" value="no" />
    <add key="Mail.From" value="notification@onelab.tw" />
    <add key="Mail.FromName" value="Turnover Control Administator" />
    <add key="Mail.To" value="" />
    <add key="Mail.Cc" value="" />
    <add key="Mail.Bcc" value="" />
    <add key="Mail.To.tag" value="" />
    <add key="Mail.Subject" value="{{Mail.Subject}}" />
    <add key="Mail.Template" value="template-mail.html" />

    <add key="Push.Enabled" value="yes" />
    <add key="Push.To" value="" />

    <add key="Push.To.Suspicious-Customer" value="10040188" />
    <add key="Push.To.Suspicious-Customer-Test" value="10040187" />

    <add key="Push.Subject" value="{{Push.Subject}}" />
    <add key="Push.Template" value="template-push.txt" />
    <add key="Push.Notify" value="yes" />
  </appSettings>
</configuration>