@using Fanex.CWLGamePayoutAlert.Business.Models;
@{
    DateTime dateTime = Model.Item1;
    List<PayoutModel> rows = Model.Item2;
}
<div>
    Dear all,<br />

    Please be notified that these following products have triggered our payout limit alter system. <br><br />
    <b>
        Date: @dateTime.ToString("MM/dd/yyyy HH:00") - @dateTime.ToString("HH:59") (GMT+8)
    </b>
    <table border="1"
           id="display" style="border-style:Solid;border-collapse:collapse;
            font-size:10pt; font-family:Tahoma, Arial, Verdana, Sans-Serif;">
        <thead>
            <tr style="height: 25px;background-color:#3C5EA5; color: #FFFFFF; font-weight: bold;">
                <td style="text-align:center; width:120px;">Product</td>
                <td style="text-align:center; width:250px;">Game Type</td>
                <td style="text-align:center; width:120px;">Bet Count</td>
                <td style="text-align:center; width:120px;">Total Bets</td>
                <td style="text-align:center; width:120px;">Total Wins</td>
                <td style="text-align:center; width:120px;">Game Income</td>
                <td style="text-align:center; width:120px;">Game Payout</td>
            </tr>
        </thead>
        <tbody>
            @foreach (PayoutModel data in rows)
            {
                decimal payout = data.GamePayout * 100;
                string cssIncome = data.GameIncome < 0 ? "red" : "";
                string cssPayout = payout > 100 ? "red" : "";
                <tr style="height: 25px; font-size:9pt; font-family:Tahoma, Arial, Verdana, Sans-Serif">
                    <td style="text-align:left;">@data.Product</td>
                    <td style="text-align:left;">@data.GameType</td>
                    <td style="text-align:right;">@data.BetCount.ToString("#,##0")</td>
                    <td style="text-align:right;">@data.TotalBetsRM.ToString("#,##0")<span>(RM)</span></td>
                    <td style="text-align:right;">@data.TotalWinsRM.ToString("#,##0")<span>(RM)</span></td>
                    <td style="text-align:right;">
                        <span style="color:@cssIncome">@data.GameIncome.ToString("#,##0.##")</span><span style="color:@cssIncome">(RM)</span>
                    </td>
                    <td style="text-align:right;"><span style="color:@cssPayout">@payout.ToString("#,##0.##")</span><span style="color:@cssPayout">%</span></td>
                </tr>
            }
        </tbody>
    </table>
    <br />

    Kindly check/monitor yourself and carry out timely actions accordingly. <br /><br />

    Regards, <br /><br />

    This is auto mail. Please do not reply<br /><br />
</div>