@using TOControl.CustomerMovement.Business.Models;
@{ 
    IEnumerable<GroupHeadline> groupHeadlines = Model;
}

<table cellspacing="0" border="1" style="border-color: #CECCCD; border-style: Solid; font-size: 9pt; font-family: Tahoma, Arial, Verdana, Sans-Serif;" rules="all">
    <thead>
        <tr style="color: white; font-weight: bold">
            <td align="center" style="background-color: #3c5ea5;" colspan="4">
                Change Group Headline(s)
            </td>
        </tr>
        <tr style="color: white; font-weight: bold">
            <td align="center" style="width: 40px; background-color: #3c5ea5;">
                #                
            </td>
            <td align="center" style="background-color: #3c5ea5; width: 200px">
                Old Headline
            </td>
            <td align="center" style="background-color: #3c5ea5; width: 200px">
                New Headline
            </td>
            <td align="center" style="background-color: #3c5ea5; width: 200px">
                Date
            </td>            
        </tr>
    </thead>
    <tbody>
        @if (!groupHeadlines.GetEnumerator().MoveNext())
        {
            <tr style="color: black;">
                <td colspan='4' align="center">
                    There is no data.
                </td>
            </tr>
        }
        else
        {
            int count = 1;
            foreach (GroupHeadline groupHeadline in groupHeadlines)
            {
                <tr style="color: black;">
                    <td align="center">
                        @count
                    </td>
                    <td align="center">
                        @groupHeadline.OldHeadline
                    </td>
                    <td align="center">
                        @groupHeadline.NewHeadline
                    </td>
                    <td align="center">
                        @groupHeadline.Date.ToString("MM/dd/yyyy hh:mm:ss tt")
                    </td>                    
                </tr>
                count++;
            }
        }
    </tbody>
</table>