@{
    var data = Model;
    List<string> files = data.Item1;
}
<div style="font-family:Tahoma; font-size:11pt;">
    <div>
        Dear All, <br /><br />

        The files:

        @foreach (string file in files)
        {
            <div style="font-family:Tahoma; font-size:10pt; font-style:italic">
                <ul>
                    <li>@file</li>
                </ul>
            </div>
        }

        have been sent to you. <br /><br />

        Please kindly find the attachment for more details. <br /><br />

        Please contact Starix IT if you can not access or download report. <br /><br />

        Thanks & Best Regards, <br /><br />

        Starix IT <br /><br />

        ---------------------------------------------------------------------- <br />
        This email is confidential. <br />
        If you are not the addressee you may not copy, forward, disclose or use any part of it. <br />
        If you have received this message in error, please delete it from your system. <br />
        This is an auto-generated email, please do not reply. <br />
    </div>
</div>