@{
    var data = Model;
    List<string> fileNames = data.Item1;
    string linkNapReport = data.Item2;
}
<div style="font-family:Tahoma; font-size:10pt;">
    Dear User, <br /><br />

    This is to notify you that the
    <ul>
        @{
            foreach (string filename in fileNames)
            {
                <li>
                    <b>@filename</b>
                </li>
            }
        }
    </ul>report has been generated successfully. <br /><br />

    Your report is placed at Nap Accounting Report/Misc/Auto-Generated Reports.<br /><br />

    Please kindly access to this link to download report file(s). <br /><br />

    <a href="@linkNapReport" target="_blank">Nap-Accounting Report</a> <br /><br />

    Please contact Starix IT if you can not access or download report.<br /><br />

    Sincerely, <br /> <br />

    StarixIT.<br /> <br />

    ---------------------------------------------------------------------- <br />
    <i>
        This email is confidential. <br />
        If you are not the addressee you may not copy, forward, disclose or use any part of it. <br />
        If you have received this message in error, please delete it from your system. <br />
        This is an auto-generated email, please do not reply.<br />
    </i>
</div>