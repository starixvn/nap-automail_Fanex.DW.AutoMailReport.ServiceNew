@using TOControl.Notification.Business.Models;
@{
    IEnumerable<Movement> movements = Model;
}

<table cellspacing="0" border="1" style="border-color: #CECCCD; border-style: Solid; font-size: 9pt; font-family: Tahoma, Arial, Verdana, Sans-Serif;" rules="all">
    <thead>
        <tr style="color: white; font-weight: bold">
            <td align="center" colspan="5" style="background-color: #3c5ea5">
                Customer added to or removed from the monitored Group(s)
            </td>
        </tr>
        <tr style="color: white; font-weight: bold">
            <td align="center" style="width: 40px; background-color: #3c5ea5;">
                #
            </td>
            <td align="center" style="background-color: #3c5ea5; width: 200px">
                Group Headline
            </td>
            <td align="center" style="background-color: #3c5ea5; width: 200px">
                Group Member
            </td>
            <td align="center" style="background-color: #3c5ea5; width: 200px">
                Date
            </td>
            <td align="center" style="background-color: #3c5ea5; width: 100px">
                Action
            </td>
        </tr>
    </thead>
    <tbody>
        @if (!movements.GetEnumerator().MoveNext())
        {
            <tr style="color: black;">
                <td colspan='5' align="center">
                    There is no data.
                </td>
            </tr>
        }
        else
        {
            int count = 1;
            string groupHeadline = "";
            foreach (Movement movement in movements)
            {
                <tr style="color: black;">
                    <td align="center">
                        @count
                    </td>
                    @if (groupHeadline != movement.GroupHeadline)
                    {
                        groupHeadline = movement.GroupHeadline;
                        <td align="center" rowspan="@movement.Count">
                            @movement.GroupHeadline
                        </td>
                    }
                    <td align="center">
                        @movement.GroupMember
                    </td>
                    <td align="center">
                        @movement.Date.ToString("MM/dd/yyyy hh:mm:ss tt")
                    </td>
                    <td align="center">
                        @movement.Action
                    </td>
                </tr>
                count++;
            }
        }
    </tbody>
</table>