@using TOControl.Notification.Business.Models;
@using TOControl.Notification.Business.Services;
@{ 
    var data = Model;
    IEnumerable<GroupHeadline> groupHeadlines = data.Item1;
    IEnumerable<Movement> movements = data.Item2;
    IEnumerable<DirectCustomer> directCustomers = data.Item3;
    DateService date = data.Item4;
}
<div style="font-size: 10pt; font-family: Tahoma, Arial, Verdana, Sans-Serif;">   
    <p>
        <div>Dear all, <br /><br /></div>
        <div>From @date.FromDate.ToString("MM/dd/yyyy") to @date.ToDate.ToString("MM/dd/yyyy"), there are the event(s) below:</div>
    </p>
    <p>        
        <div style="margin-top:20px">
            @Include("groupHeadline", groupHeadlines) 
        </div>
    </p>
    <p>
        <div style="margin-top:20px">
            @Include("customerMovement", movements) 
        </div>
    </p>
    <p>
        <div style="margin-top:20px">
            @Include("directCustomers", directCustomers) 
        </div>
    </p>
    <p>
        <div>Please check and carry out timely actions accordingly. <br /></div>
        <div>Thank you.<br /><br /></div>
        <div style="font-weight:bold">This is an auto-mail. Please do not reply.</div>
    </p>
</div>