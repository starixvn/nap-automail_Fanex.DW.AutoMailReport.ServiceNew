<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
  </configSections>
  <appSettings>
    <add key="app_mail_address" value="$app_mail_address_value" />
    <add key="app_mail_id" value="$app_mail_id_value" />
  </appSettings>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" filePath="$FilePath" />
</configuration>