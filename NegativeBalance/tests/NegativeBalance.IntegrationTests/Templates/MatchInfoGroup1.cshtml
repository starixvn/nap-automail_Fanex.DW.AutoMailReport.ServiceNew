@{ 
    int index = @Model.Item1;
    var match = @Model.Item2; 
}
<div style="font-weight: bold">
    賽事 @index- Match @index: (@match.MatchInfo.HomeNameCS vs @match.MatchInfo.AwayNameCS) @match.MatchInfo.HomeName vs @match.MatchInfo.AwayName
</div>
<br />
<div>
    賽事日期 - Event Date: @match.MatchInfo.EventDate.ToString("d")
</div>
<br />
<div>
    賽事碼 - Match Code: @match.MatchInfo.MatchCode
</div>
<br />
<div>
    賽事ID- Match ID: @match.MatchInfo.MatchId
</div>

