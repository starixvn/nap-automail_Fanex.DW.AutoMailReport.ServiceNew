<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" />
  <Fanex.MailDelivery.Client environment="local" applicationSendMailId="1" siteId="1" rabbitMQConnectionString="host=10.18.200.209,10.18.200.202;virtualHost=/philliphost;username=rabbitclient" messageBrokerLogCategory="MailCentralized">
    <Functions>
      <!--<add id="1" name="YourFunction" />-->
    </Functions>
    <Schedules>
      <!--<Schedule id="2" name="YourSchedule" job="YourProject.Namespace.Job, YourProject">-->
    </Schedules>
  </Fanex.MailDelivery.Client>
  <appSettings>    
    <add key="Environment" value="LOCAL" />
    <add key="ExportDataDirectory" value="\\10.70.70.242\www\Olympus\Fanex.Excel\FastMarketWeeklyPerformance" />
    <add key="ExcelPasswordProtected" value="" />
    <add key="ReportDateRange" value="Weekly" />
    <add key="IsCheckEnoughData" value="false" />
    <add key="FromDate" value="2017-01-01" />
    <add key="ToDate" value="2017-01-07" />
    <add key="FunctionIdNodata" value="90" />
    <add key="Subject" value="Automail - Fast Market - Weekly Performance" />
    <add key="Title" value="Auto Generated Report Administrator" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="nunit.framework" publicKeyToken="2638cd05610744eb" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.7.1.0" newVersion="3.7.1.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>